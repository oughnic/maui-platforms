<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Everything this repo needs (MAUI 11 RC, dotnet/maui-labs backends, DevFlow) is published to nuget.org.
       To try nightly labs builds instead, add the dotnet10 feed:
       https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
