<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPlatforms.Wave3.D4Page"
             Title="D4">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Spacing="8" Padding="8">
            <Button x:Name="ShowBtn" Text="Set ItemsSource, then show" Clicked="OnShow" />
            <Label x:Name="Status" VerticalOptions="Center" Text="hidden" />
        </HorizontalStackLayout>
        <Grid x:Name="Host" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*">
            <Label Text="Results" />
            <CollectionView x:Name="List" Grid.Row="1">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,4">
                            <Label Text="{Binding .}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
