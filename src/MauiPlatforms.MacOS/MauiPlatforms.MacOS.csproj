<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS AppKit head for the shared MAUI app in ../MauiPlatforms (NOT Mac Catalyst).
    Apple Silicon only (osx-arm64). Builds only on macOS with Xcode and the `macos` workload installed;
    mirrors platforms/MacOS/templates/maui-macos-app and samples/DevFlow.Sample.MacOS in dotnet/maui-labs.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiPlatforms</RootNamespace>
    <AssemblyName>MauiPlatforms.MacOS</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>

    <!--
      Microsoft.Maui.DevFlow.Agent.Core.targets (preview.12) only hooks MAUI's XAML AdditionalFiles pipeline for
      android/ios/maccatalyst/windows TFMs; `macos` is not in the list, so Debug builds lose InitializeComponent
      (dotnet/maui-labs#520). Release builds are unaffected because the source maps are Debug-only.
    -->
    <DevFlowXamlSourceMapsEnabled>false</DevFlowXamlSourceMapsEnabled>

    <ApplicationTitle>MauiPlatforms</ApplicationTitle>
    <ApplicationId>com.companyname.mauiplatforms</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-*" />
  </ItemGroup>

  <!-- Shared app sources (everything except the platform folders and the standard MauiProgram) -->
  <ItemGroup>
    <Compile Include="..\MauiPlatforms\**\*.cs"
             Exclude="..\MauiPlatforms\Platforms\**;..\MauiPlatforms\MauiProgram.cs;..\MauiPlatforms\obj\**;..\MauiPlatforms\bin\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="..\MauiPlatforms\**\*.xaml"
              Exclude="..\MauiPlatforms\Platforms\**;..\MauiPlatforms\obj\**;..\MauiPlatforms\bin\**"
              Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Shared app resources. Only MauiIcon is processed by the labs macOS targets (SVG -> .icns). MAUI's Resizetizer does
    not run for the macos TFM, so MauiImage/MauiFont/MauiAsset items from the shared project never reach the bundle
    (docs/status.md F14). The backend loads images from <bundle>/Contents/Resources/Images and fonts from
    .../Fonts (ImageHandler, MacOSFontRegistrar), and BundleResource strips the leading "Resources\" from the Link
    path, so bundle the shared files explicitly.
  -->
  <ItemGroup>
    <MauiIcon Include="..\MauiPlatforms\Resources\AppIcon\appicon.svg" ForegroundFile="..\MauiPlatforms\Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <BundleResource Include="..\MauiPlatforms\Resources\Images\*" Link="Resources\Images\%(Filename)%(Extension)" />
    <BundleResource Include="..\MauiPlatforms\Resources\Fonts\*" Link="Resources\Fonts\%(Filename)%(Extension)" />
    <BundleResource Include="..\MauiPlatforms\Resources\Raw\**" Link="Resources\Raw\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
